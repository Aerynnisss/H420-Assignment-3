# Environment variables used by the pipeline.
# 
#
# How to use it (in your WSL / Linux terminal):
#   1. Add each line below to your ~/.bashrc with "export" in front, for example:
#        export DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
#   2. Run: source ~/.bashrc
#   3. Restart "airflow standalone" so Airflow also sees the variables.
# See section 3.7 "Environment variables" of the README.

# Airflow: absolute path to the dags folder of this repository
AIRFLOW__CORE__DAGS_FOLDER=/absolute/path/to/H420-Assignment-3/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Google Drive-synced folders (optional, default: library/papers and library/output of the repository)
PAPERS_DIR=/mnt/c/Users/<you>/My Drive/ResearchLibrary/papers
OUTPUT_DIR=/mnt/c/Users/<you>/My Drive/ResearchLibrary/output

# Discord webhook - REQUIRED
# (Discord > Edit Channel > Integrations > Webhooks > New Webhook > Copy Webhook URL).
# If it is not set, the "notify" task fails with "DISCORD_WEBHOOK_URL is not set".
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-token

# Local LLM served by Ollama (default values, change them only if needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b

# Seconds to wait before processing a new PDF (it may still be syncing)
MIN_FILE_AGE_SECONDS=60
